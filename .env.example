# Optional local overrides. bin/dev (Foreman) loads .env; standalone Rails
# commands do not. No .env, credentials, or provider accounts are needed locally.
PORT=3100
RAILS_MAX_THREADS=3

# Optional exact development tunnel hostname; never use a wildcard.
# RAILS_ALLOWED_HOSTS=your-tunnel.example.com

# Local links use the request origin by default. Production requires your own
# HTTPS origin and optionally exact extra hostnames (for example a www alias).
# PUBLIC_BASE_URL=https://your-domain.example

# Analytics is OFF by default in every environment, including production.
# Configure only your own stream after reviewing docs/analytics-and-search-console.md.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# PRODUCT_TELEMETRY_ENABLED=true
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Never put production secrets here or pass them as command-line arguments.
# See docs/deployment-plan.md for private operator configuration.
