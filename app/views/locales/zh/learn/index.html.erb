<% content_for :title, "德州扑克基础课：位置、底池赔率、决策质量 — Holdem Lab" %>
<% content_for :description, "三节免费德州扑克课程，一次只建立一个可靠概念：单挑的行动顺序、跟注的价格，以及如何不带事后诸葛地复盘一个决定。" %>
<% content_for :structured_data do %>
  <%= structured_data_script(breadcrumb_structured_data([["首页", absolute_url_for(root_path)], ["学习", canonical_url]])) %>
  <%= structured_data_script(course_list_structured_data([
        { name: "单挑德州扑克中的位置", description: "谁先拿到牌、谁先行动，以及位置能说明什么、不能说明什么。", url: absolute_url_for(position_lesson_path) },
        { name: "底池赔率：不做过度精确的结论", description: "可复算的即时跟注公式、完整例题，以及明确的模型边界。", url: absolute_url_for(pot_odds_lesson_path) },
        { name: "决策质量与结果的区别", description: "把做决定时掌握的信息和推理，与之后出现的结果分开看待。", url: absolute_url_for(decision_quality_lesson_path) }
      ])) %>
<% end %>

<section class="border-b border-ink/10">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:py-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-moss">学习 · 练习 · 总结</p>
    <h1 class="mt-5 max-w-4xl font-display text-5xl leading-[0.98] tracking-tight sm:text-7xl">一次建立一个可靠概念。</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-ink/70">每节课都会先说明覆盖范围，要求你在看到解析前先回忆规则，并明确指出这个概念到哪里为止。无需注册，关闭 JavaScript 也能完整阅读。</p>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-16 sm:py-20 lg:px-8" aria-labelledby="lesson-path-title">
  <% position_record = @content_records.fetch("position") %>
  <% position_curriculum = @curriculum_lessons.fetch("position") %>
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-moss">基础路径</p>
      <h2 class="mt-3 font-display text-4xl" id="lesson-path-title">从行动顺序开始。</h2>
    </div>
    <p class="max-w-md text-sm leading-6 text-ink/60">第一次学习建议按顺序来。每节课约十分钟，末尾有三道题，先作答再看解析。</p>
  </div>

  <div class="mt-10 grid gap-5 lg:grid-cols-3">
    <article class="flex flex-col rounded-3xl border border-moss/30 bg-moss/10 p-6" data-content-asset-id="<%= position_record.fetch("id") %>" data-content-curriculum-id="<%= position_curriculum.fetch("id") %>" data-content-publication-status="<%= position_record.fetch("publication_status") %>">
      <div class="flex items-center justify-between gap-3"><span class="text-xs font-semibold uppercase tracking-[0.16em] text-moss">01 · 基础</span><span class="rounded-full bg-sand/15 px-3 py-1 text-xs font-semibold text-sand">约 10 分钟</span></div>
      <h3 class="mt-8 font-display text-3xl">位置</h3>
      <p class="mt-3 flex-1 text-sm leading-6 text-ink/70">谁先拿到牌、谁先行动，以及位置能说明什么、不能说明什么。</p>
      <%= link_to "打开「位置」课程 →", position_lesson_path, class: "mt-8 inline-flex min-h-11 items-center justify-center rounded-full bg-moss px-5 py-3 text-sm font-semibold text-paper hover:bg-ink" %>
    </article>

    <% [["02", "底池赔率", "可复算的即时跟注公式、完整例题，以及明确的模型边界。", "pot-odds", pot_odds_lesson_path], ["03", "决策质量", "把做决定时掌握的信息和推理，与之后出现的结果分开看待。", "decision-quality", decision_quality_lesson_path]].each do |number, title, body, slug, path| %>
      <% record = @content_records.fetch(slug) %>
      <% curriculum = @curriculum_lessons.fetch(slug) %>
      <article class="flex flex-col rounded-3xl border border-ink/10 bg-white/55 p-6" data-content-asset-id="<%= record.fetch("id") %>" data-content-curriculum-id="<%= curriculum.fetch("id") %>" data-content-publication-status="<%= record.fetch("publication_status") %>">
        <div class="flex items-center justify-between gap-3"><span class="text-xs font-semibold uppercase tracking-[0.16em] text-ink/45"><%= number %> · 基础</span><span class="rounded-full bg-sand/15 px-3 py-1 text-xs font-semibold text-sand">约 10 分钟</span></div>
        <h3 class="mt-8 font-display text-3xl"><%= title %></h3>
        <p class="mt-3 flex-1 text-sm leading-6 text-ink/65"><%= body %></p>
        <%= link_to "打开「#{title}」课程 →", path, class: "mt-8 inline-flex min-h-11 items-center justify-center rounded-full border border-ink/15 px-5 py-3 text-sm font-semibold text-ink hover:border-moss hover:text-moss" %>
      </article>
    <% end %>
  </div>
</section>
