<% content_for :title, "Learn Texas Hold'em Fundamentals — Position, Pot Odds, Decision Quality" %>
<% content_for :description, "Three free Texas Hold'em lessons, one concept at a time: heads-up action order, the price of a call, and reviewing a decision without hindsight." %>
<% content_for :structured_data do %>
  <%= structured_data_script(breadcrumb_structured_data([["Home", absolute_url_for(root_path)], ["Learn", canonical_url]])) %>
  <%= structured_data_script(course_list_structured_data([
        { name: "Position in heads-up Hold'em", description: "Who receives the first card, who acts first, and what position does—and does not—tell you.", url: absolute_url_for(position_lesson_path) },
        { name: "Pot odds without false precision", description: "A reproducible immediate-call formula, worked examples, and explicit modeling limits.", url: absolute_url_for(pot_odds_lesson_path) },
        { name: "Decision quality versus outcome", description: "Separate the information and reasoning available at decision time from the eventual result.", url: absolute_url_for(decision_quality_lesson_path) }
      ])) %>
<% end %>

<section class="border-b border-ink/10">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:py-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-moss">Learn · practice · summarize</p>
    <h1 class="mt-5 max-w-4xl font-display text-5xl leading-[0.98] tracking-tight sm:text-7xl">Build one reliable concept at a time.</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-ink/70">Each lesson states what it covers, asks you to recall the rule before showing feedback, and says plainly where the concept stops. No account needed, and every lesson works without JavaScript.</p>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-16 sm:py-20 lg:px-8" aria-labelledby="lesson-path-title">
  <% position_record = @content_records.fetch("position") %>
  <% position_curriculum = @curriculum_lessons.fetch("position") %>
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-moss">Foundation path</p>
      <h2 class="mt-3 font-display text-4xl" id="lesson-path-title">Start with action order.</h2>
    </div>
    <p class="max-w-md text-sm leading-6 text-ink/60">Take them in order the first time through. Each one is about ten minutes and ends with three questions you answer before seeing the explanation.</p>
  </div>

  <div class="mt-10 grid gap-5 lg:grid-cols-3">
    <article class="flex flex-col rounded-3xl border border-moss/30 bg-moss/10 p-6" data-content-asset-id="<%= position_record.fetch("id") %>" data-content-curriculum-id="<%= position_curriculum.fetch("id") %>" data-content-publication-status="<%= position_record.fetch("publication_status") %>">
      <div class="flex items-center justify-between gap-3"><span class="text-xs font-semibold uppercase tracking-[0.16em] text-moss">01 · Foundation</span><span class="rounded-full bg-sand/15 px-3 py-1 text-xs font-semibold text-sand">10 min</span></div>
      <h3 class="mt-8 font-display text-3xl">Position</h3>
      <p class="mt-3 flex-1 text-sm leading-6 text-ink/70">Who receives the first card, who acts first, and what position does—and does not—tell you.</p>
      <%= link_to "Open the Position lesson →", position_lesson_path, class: "mt-8 inline-flex min-h-11 items-center justify-center rounded-full bg-moss px-5 py-3 text-sm font-semibold text-paper hover:bg-ink" %>
    </article>

    <% [["02", "Pot Odds", "A reproducible immediate-call formula, worked examples, and explicit modeling limits.", "pot-odds", pot_odds_lesson_path], ["03", "Decision Quality", "Separate the information and reasoning available at decision time from the eventual result.", "decision-quality", decision_quality_lesson_path]].each do |number, title, body, slug, path| %>
      <% record = @content_records.fetch(slug) %>
      <% curriculum = @curriculum_lessons.fetch(slug) %>
      <article class="flex flex-col rounded-3xl border border-ink/10 bg-white/55 p-6" data-content-asset-id="<%= record.fetch("id") %>" data-content-curriculum-id="<%= curriculum.fetch("id") %>" data-content-publication-status="<%= record.fetch("publication_status") %>">
        <div class="flex items-center justify-between gap-3"><span class="text-xs font-semibold uppercase tracking-[0.16em] text-ink/45"><%= number %> · Foundation</span><span class="rounded-full bg-sand/15 px-3 py-1 text-xs font-semibold text-sand">10 min</span></div>
        <h3 class="mt-8 font-display text-3xl"><%= title %></h3>
        <p class="mt-3 flex-1 text-sm leading-6 text-ink/65"><%= body %></p>
        <%= link_to "Open the #{title} lesson →", path, class: "mt-8 inline-flex min-h-11 items-center justify-center rounded-full border border-ink/15 px-5 py-3 text-sm font-semibold text-ink hover:border-moss hover:text-moss" %>
      </article>
    <% end %>
  </div>
</section>
