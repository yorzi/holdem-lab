<!DOCTYPE html>
<html lang="<%= locale_html_tag %>">
  <head>
    <title><%= seo_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= seo_description %>">
    <meta name="robots" content="<%= seo_robots %>">
<% analytics_site_verifications.each do |name, content| %>
    <meta name="<%= name %>" content="<%= content %>">
<% end %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Holdem Lab">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#1c2b27">
    <meta name="holdem-telemetry" content="<%= Rails.application.config.x.telemetry_enabled %>">
    <meta name="holdem-locale" content="<%= current_locale %>">

    <meta property="og:type" content="<%= seo_og_type %>">
    <meta property="og:site_name" content="Holdem Lab">
    <meta property="og:title" content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:locale" content="<%= seo_og_locale %>">
    <meta property="og:locale:alternate" content="<%= seo_alternate_og_locale %>">
    <meta property="og:image" content="<%= seo_image_url %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= t('site.og_image_alt') %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seo_title %>">
    <meta name="twitter:description" content="<%= seo_description %>">
    <meta name="twitter:image" content="<%= seo_image_url %>">
    <meta name="twitter:image:alt" content="<%= t('site.og_image_alt') %>">

    <link rel="canonical" href="<%= canonical_url %>">
    <link rel="alternate" hreflang="en" href="<%= absolute_url_for(locale_switch_path(:en, preserve_query: false)) %>">
    <link rel="alternate" hreflang="zh-Hans" href="<%= absolute_url_for(locale_switch_path(:zh, preserve_query: false)) %>">
    <link rel="alternate" hreflang="x-default" href="<%= absolute_url_for(locale_switch_path(:en, preserve_query: false)) %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "shared/analytics_head" %>

    <%= structured_data_script(site_structured_data) %>
    <%= yield :structured_data %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application.tsx' %>
  </head>

  <body class="bg-paper text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/90 backdrop-blur-md" data-controller="disclosure">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex min-h-[76px] flex-wrap items-center justify-between gap-6">
          <%= link_to root_path, class: "group flex min-w-0 items-center gap-3", aria: { label: t("nav.home_label") } do %>
            <%= image_tag "/icon.png", alt: "", class: "h-10 w-10 shrink-0 rounded-[1.1rem] shadow-sm ring-1 ring-ink/10", aria: { hidden: true } %>
            <span class="min-w-0">
              <span class="block font-display text-lg font-semibold tracking-tight">Holdem Lab</span>
              <span class="hidden text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-ink/45 sm:block"><%= t("nav.brand_descriptor") %></span>
            </span>
          <% end %>

          <button
            class="inline-flex min-h-11 items-center rounded-full border border-ink/15 bg-paper px-4 text-sm font-semibold text-ink shadow-sm transition-colors hover:border-moss hover:text-moss md:hidden"
            type="button"
            aria-controls="main-navigation"
            aria-expanded="false"
            aria-label="<%= t("nav.toggle_navigation") %>"
            data-disclosure-target="trigger"
            data-action="click->disclosure#toggle"
          >
            <%= t("nav.menu") %>
          </button>

          <nav id="main-navigation" class="order-3 hidden w-full border-t border-ink/10 pb-5 pt-4 md:order-none md:block md:w-auto md:border-t-0 md:pb-0 md:pt-0" data-disclosure-target="panel">
            <div class="flex flex-col gap-5 md:flex-row md:items-center md:gap-8">
              <div class="flex flex-wrap items-center gap-5 text-sm font-semibold">
                <% learn_active = site_nav_active?(:learn) %>
                <%= link_to t("nav.learn"), learn_path, class: "border-b-2 border-transparent py-2 transition-colors #{learn_active ? "border-moss text-ink" : "text-ink/60 hover:border-ink/20 hover:text-ink"}", aria: (learn_active ? { current: "page" } : {}) %>
                <% methodology_active = site_nav_active?(:methodology) %>
                <%= link_to t("nav.methodology"), methodology_path, class: "border-b-2 border-transparent py-2 transition-colors #{methodology_active ? "border-moss text-ink" : "text-ink/60 hover:border-ink/20 hover:text-ink"}", aria: (methodology_active ? { current: "page" } : {}) %>
              </div>

              <div class="flex flex-col gap-3 sm:flex-row sm:items-center md:gap-5">
                <%= link_to t("nav.start_practice"), practice_path, class: "inline-flex min-h-11 items-center justify-center rounded-full bg-moss px-5 py-2.5 text-center text-sm font-semibold text-paper shadow-sm transition-colors hover:bg-ink", aria: (site_nav_active?(:practice) ? { current: "page" } : {}) %>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold">
                  <% if current_user %>
                    <% account_label = current_user.display_name.presence || t("nav.account") %>
                    <details class="relative">
                      <summary class="flex min-h-10 max-w-48 cursor-pointer list-none items-center rounded-full border border-ink/15 bg-paper px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-moss hover:text-moss [&::-webkit-details-marker]:hidden" aria-haspopup="menu">
                        <span class="truncate"><%= account_label %></span>
                      </summary>
                      <div class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-48 rounded-2xl border border-ink/10 bg-paper p-2 text-sm font-semibold shadow-xl">
                        <%= link_to account_label, profile_settings_path, class: "block rounded-xl px-3 py-2.5 text-ink/70 transition-colors hover:bg-paper-deep hover:text-ink" %>
                        <%= button_to t("nav.sign_out"), session_path, method: :delete, form_class: "w-full", class: "block w-full rounded-xl px-3 py-2.5 text-left text-ink/70 transition-colors hover:bg-paper-deep hover:text-ink" %>
                      </div>
                    </details>
                  <% else %>
                    <%= link_to t("nav.sign_in"), new_session_path, class: "text-ink/65 transition-colors hover:text-moss" %>
                  <% end %>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="bg-ink px-5 py-14 text-paper sm:py-20 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
          <div class="max-w-xl">
            <div class="flex items-center gap-3">
              <%= image_tag "/icon.png", alt: "", class: "h-11 w-11 rounded-[1.15rem] shadow-sm ring-1 ring-paper/20", aria: { hidden: true } %>
              <div>
                <p class="font-display text-lg font-semibold">Holdem Lab</p>
                <p class="mt-0.5 text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-paper/45"><%= t("nav.brand_descriptor") %></p>
              </div>
            </div>
            <p class="mt-10 text-xs font-semibold uppercase tracking-[0.2em] text-sand"><%= t("footer.eyebrow") %></p>
            <h2 class="mt-3 max-w-lg font-display text-4xl leading-tight tracking-tight sm:text-5xl"><%= t("footer.heading") %></h2>
            <p class="mt-5 max-w-lg text-base leading-7 text-paper/65"><%= t("footer.description") %></p>
            <%= link_to t("footer.cta"), practice_path, class: "mt-8 inline-flex min-h-11 items-center justify-center rounded-full bg-sand px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-paper" %>
          </div>

          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:pt-2">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/45"><%= t("footer.learn_group") %></p>
              <nav class="mt-4 flex flex-col items-start gap-3 text-sm font-semibold" aria-label="<%= t("footer.site_links") %>">
                <%= link_to t("nav.learn"), learn_path, class: "text-paper/75 transition-colors hover:text-sand" %>
                <%= link_to t("footer.position_lesson"), position_lesson_path, class: "text-paper/55 transition-colors hover:text-sand" %>
                <%= link_to t("footer.pot_odds_lesson"), pot_odds_lesson_path, class: "text-paper/55 transition-colors hover:text-sand" %>
                <%= link_to t("footer.decision_quality_lesson"), decision_quality_lesson_path, class: "text-paper/55 transition-colors hover:text-sand" %>
              </nav>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/45"><%= t("footer.product_group") %></p>
              <nav class="mt-4 flex flex-col items-start gap-3 text-sm font-semibold" aria-label="<%= t("footer.product_group") %>">
                <%= link_to t("nav.start_practice"), practice_path, class: "text-paper/75 transition-colors hover:text-sand" %>
                <%= link_to t("nav.methodology"), methodology_path, class: "text-paper/55 transition-colors hover:text-sand" %>
                <%= link_to t("footer.privacy"), privacy_path, class: "text-paper/55 transition-colors hover:text-sand" %>
                <% if current_user %>
                  <%= link_to t("nav.account"), profile_settings_path, class: "text-paper/55 transition-colors hover:text-sand" %>
                <% else %>
                  <%= link_to t("nav.sign_in"), new_session_path, class: "text-paper/55 transition-colors hover:text-sand" %>
                <% end %>
              </nav>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/45"><%= t("footer.language_group") %></p>
              <% current_language_label = current_locale == :zh ? "简体中文" : "English" %>
              <details class="relative mt-4 w-full sm:w-auto" data-testid="footer-language-menu">
                <summary class="flex min-h-10 w-full cursor-pointer list-none items-center justify-between gap-4 rounded-full border border-paper/25 bg-paper/5 px-4 py-2 text-sm font-semibold text-paper transition-colors hover:border-sand hover:text-sand sm:w-auto [&::-webkit-details-marker]:hidden" aria-haspopup="menu" aria-label="<%= t("nav.language") %>: <%= current_language_label %>">
                  <span><%= current_language_label %></span>
                  <svg class="h-4 w-4 shrink-0 text-paper/60" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" />
                  </svg>
                </summary>
                <div class="absolute bottom-[calc(100%+0.5rem)] left-0 z-50 min-w-48 rounded-2xl border border-ink/10 bg-paper p-2 text-sm font-semibold text-ink shadow-xl sm:right-0 sm:left-auto">
                  <% [ [ "English", :en, "en" ], [ "简体中文", :zh, "zh-Hans" ] ].each do |language_label, language_locale, language_tag| %>
                    <% language_selected = current_locale == language_locale %>
                    <%= link_to locale_switch_path(language_locale), lang: language_tag, aria: (language_selected ? { current: "true" } : {}), class: "flex items-center justify-between gap-4 rounded-xl px-3 py-2.5 transition-colors #{language_selected ? "bg-paper-deep text-ink" : "text-ink/70 hover:bg-paper-deep hover:text-ink"}" do %>
                      <span><%= language_label %></span>
                      <% if language_selected %>
                        <svg class="h-4 w-4 shrink-0 text-moss" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <path d="m4.5 10.5 3.25 3.25L15.5 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                        </svg>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </details>
            </div>
          </div>
        </div>

        <div class="mt-14 flex flex-col gap-4 border-t border-paper/15 pt-6 text-sm text-paper/55 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-2xl"><span class="mr-2 inline-flex rounded-full bg-sand/15 px-2 py-1 text-xs font-semibold text-sand"><%= t("footer.virtual_chips_label") %></span><%= t("footer.virtual_chips") %></p>
          <p class="sm:text-right"><%= t("footer.evidence_first") %></p>
        </div>
      </div>
    </footer>

    <%= render "shared/analytics_consent_banner" %>
  </body>
</html>
