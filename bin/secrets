#!/usr/bin/env ruby
# frozen_string_literal: true

# summary: Edit, inspect, and run commands against the age-encrypted secret vaults
# group: secrets
#
# bin/secrets — the one place a secret is written down.
#
# Values live encrypted in ignored config/secrets/<env>.enc.yaml. Keep private
# vault backups outside this public repository. SOPS leaves *names* readable, so a
# diff still reads "OPENROUTER_API_KEY changed" rather than "the blob changed",
# and the inventory commands below never have to decrypt anything.
#
# That split is the design, not an implementation detail:
#
#   list / status   read the ciphertext only. They work on a machine with no
#                   key at all, they run in CI, and they cannot print a value
#                   because they never have one.
#   edit / exec /   decrypt in memory. Plaintext never reaches the disk, a
#   push            shell command line, or a shell history.
#
# The vault is the source of truth. GitHub Actions secrets are a *derived copy*
# kept in step by `bin/secrets push`, which is why CI can keep naming each
# secret individually instead of holding one key that unlocks everything.
#
# Usage:
#   bin/secrets                              # status: vault vs deploy.yml vs GitHub
#   bin/secrets init                         # first run on a new machine or repo
#   bin/secrets list [ENV]                   # names present, never values
#   bin/secrets edit [ENV]                   # $EDITOR on the decrypted vault
#   bin/secrets exec [ENV] -- CMD [ARGS...]  # run CMD with the vault in its env
#   bin/secrets import ENV --from .env       # seed a vault from a KEY=VALUE file
#   bin/secrets scaffold [ENV]               # declare every name deploy.yml/CI requires
#   bin/secrets push [production]            # mirror the vault to GitHub secrets
#   bin/secrets rekey                        # re-encrypt after editing .sops.yaml
#
# ENV defaults to development everywhere except `push`, which is production-only.
#
# The private key is an age identity at ~/.config/sops/age/keys.txt and is never
# in this repository. Lose it and every vault here is unreadable forever, so
# `init` refuses to overwrite one and tells you to back it up before you have
# anything encrypted to lose.

require "json"
require "open3"
require "optparse"
require "shellwords"
require "yaml"

module Secrets
  ROOT = File.expand_path("..", __dir__)
  VAULT_DIR = File.join(ROOT, "config/secrets")
  SOPS_CONFIG = File.join(ROOT, ".sops.yaml")
  # The age identity, deliberately at the XDG path rather than macOS's
  # ~/Library/Application Support default: one path that reads the same in this
  # file, in the runbook, and on a Linux box.
  KEY_FILE = File.expand_path("~/.config/sops/age/keys.txt")
  ENVIRONMENTS = %w[development production].freeze
  # Nothing in a vault is optional-by-name, but these are the ones whose absence
  # from production breaks a deploy rather than degrading a feature.
  PUSHABLE = "production"

  module_function

  # --- plumbing ---------------------------------------------------------------

  def abort!(message)
    warn "secrets: #{message}"
    exit 1
  end

  def sops!
    return @sops if defined?(@sops) && @sops

    path, status = Open3.capture2e("which", "sops")
    abort!("sops is not installed — brew install sops age") unless status.success?
    @sops = path.strip
  end

  def key_available?
    File.exist?(ENV["SOPS_AGE_KEY_FILE"] || KEY_FILE)
  end

  # sops looks at SOPS_AGE_KEY_FILE, then its platform config dir. Point it at
  # the one path this repository documents, so a machine that has the key finds
  # it whether or not the operator exported anything.
  def sops_env
    return {} if ENV["SOPS_AGE_KEY_FILE"]
    return {} unless File.exist?(KEY_FILE)

    { "SOPS_AGE_KEY_FILE" => KEY_FILE }
  end

  def vault_path(environment)
    File.join(VAULT_DIR, "#{environment}.enc.yaml")
  end

  def resolve_environment(name, default: "development")
    environment = name || default
    unless ENVIRONMENTS.include?(environment)
      abort!("unknown environment #{environment.inspect} — one of: #{ENVIRONMENTS.join(', ')}")
    end
    environment
  end

  def require_vault!(environment)
    path = vault_path(environment)
    abort!("no vault at config/secrets/#{environment}.enc.yaml — run bin/secrets init") unless File.exist?(path)
    path
  end

  def require_key!
    return if key_available?

    abort!(<<~MESSAGE.strip)
      no age identity at #{KEY_FILE}.
              This machine cannot decrypt the vaults. Either restore the key from your
              password manager, or have a machine that has it add your public key:
                bin/secrets init          # on this machine, prints your public key
                # then, on a machine that can already decrypt:
                #   add the key to .sops.yaml and run `bin/secrets rekey`
    MESSAGE
  end

  # --- reading without decrypting ---------------------------------------------

  # SOPS leaves mapping keys in plaintext, so the whole inventory is readable
  # from the ciphertext. Everything that only needs names goes through here and
  # therefore cannot leak a value even in principle.
  def names(environment)
    path = vault_path(environment)
    return [] unless File.exist?(path)

    entries(environment).keys.sort
  end

  # SOPS has nothing to encrypt in an empty string, so it leaves one as a bare
  # `NAME: ""`. That is not a leak — it is how a name declares itself present
  # but unfilled, and it means the two checks below can tell "still to paste in"
  # apart from "someone committed a plaintext value" without decrypting either.
  def blank_names(environment)
    entries(environment).select { |_, value| value.to_s.empty? }.keys.sort
  end

  # The guard against a decrypted spill being committed: every value that has
  # any content at all must be an ENC[...] string.
  def unencrypted_names(environment)
    entries(environment).reject { |_, value| value.to_s.empty? || value.to_s.start_with?("ENC[") }.keys.sort
  end

  def entries(environment)
    path = vault_path(environment)
    return {} unless File.exist?(path)

    document = YAML.safe_load_file(path, aliases: true) || {}
    document.reject { |key, _| key == "sops" }
  end

  # --- reading with decrypting ------------------------------------------------

  def load_values(environment)
    require_key!
    path = require_vault!(environment)

    # Inherit stdin and stderr: a passphrase-protected identity prompts on the
    # terminal, and swallowing that would look like a hang.
    output = IO.popen(sops_env, [ sops!, "decrypt", "--output-type", "json", path ], "r", &:read)
    abort!("could not decrypt config/secrets/#{environment}.enc.yaml") unless $?.success?

    values = JSON.parse(output)
    values.reject { |key, _| key == "sops" }
  rescue JSON::ParserError
    abort!("config/secrets/#{environment}.enc.yaml did not decrypt to a JSON object")
  end

  # --- what this repository requires -------------------------------------------
  #
  # Derived from configuration that already exists, never a list maintained
  # here — a list would go stale the first time someone added a secret. Each
  # source is optional; a project that has none can still declare names by hand
  # with `bin/secrets edit`.

  # Kamal (config/deploy.yml): env.secret plus the registry password.
  def deploy_contract
    path = File.join(ROOT, "config/deploy.yml")
    return [] unless File.exist?(path)

    config = YAML.safe_load(File.read(path).gsub(/<%=?.*?%>/m, "tmp"), aliases: true) || {}
    (Array(config.dig("env", "secret")) + Array(config.dig("registry", "password"))).uniq.sort
  end

  # Every name a GitHub Actions workflow reads.
  def workflow_names
    Dir[File.join(ROOT, ".github/workflows/*.y{a,}ml")]
      .flat_map { |path| File.read(path).scan(/secrets\.([A-Z0-9_]+)/).flatten }
      .uniq.reject { |name| name == "GITHUB_TOKEN" }
      .sort
  end

  # Names documented in .env.example, commented out or not.
  def example_names
    path = File.join(ROOT, ".env.example")
    return [] unless File.exist?(path)

    File.readlines(path).filter_map { |line| line[/\A#?\s*([A-Z][A-Z0-9_]*)=/, 1] }.uniq.sort
  end

  # Production also carries the infrastructure secrets only CI uses (registry,
  # SSH, object storage); development carries the application's own.
  def required_names(environment)
    app = (deploy_contract | example_names).sort
    environment == "production" ? (app | workflow_names).sort : app
  end

  def github_names
    output, status = Open3.capture2("gh", "secret", "list", "--json", "name", "--jq", ".[].name", chdir: ROOT)
    return nil unless status.success?

    output.split("\n").map(&:strip).reject(&:empty?).sort
  rescue Errno::ENOENT
    nil
  end

  # --- commands ---------------------------------------------------------------

  def cmd_init(_argv)
    sops!
    puts "secrets: setting up SOPS + age for this repository"

    if File.exist?(KEY_FILE)
      public_key = File.read(KEY_FILE)[/# public key: (age1\S+)/, 1]
      puts "  · age identity already present at #{KEY_FILE} — left untouched"
      puts "    public key: #{public_key}" if public_key
    else
      require "fileutils"
      FileUtils.mkdir_p(File.dirname(KEY_FILE), mode: 0o700)
      unless system("age-keygen", "-o", KEY_FILE)
        abort!("age-keygen failed — brew install age")
      end
      File.chmod(0o600, KEY_FILE)
      public_key = File.read(KEY_FILE)[/# public key: (age1\S+)/, 1]
      puts "  ✓ generated an age identity at #{KEY_FILE}"
      puts
      puts "  ┌─ BACK THIS UP NOW, BEFORE ENCRYPTING ANYTHING ────────────────────"
      puts "  │ Copy the whole of #{KEY_FILE} into your password manager."
      puts "  │ It is the only thing that can read config/secrets/*.enc.yaml."
      puts "  │ There is no recovery path — a lost identity is a lost vault."
      puts "  └───────────────────────────────────────────────────────────────────"
      puts
      puts "    public key: #{public_key}"
    end

    if File.exist?(SOPS_CONFIG)
      recipients = File.read(SOPS_CONFIG).scan(/age1[a-z0-9]+/).uniq
      if public_key && !recipients.include?(public_key)
        warn "  ! .sops.yaml does not list this machine's public key."
        warn "    Add #{public_key} to it, then run `bin/secrets rekey` on a machine that can already decrypt."
      else
        puts "  · .sops.yaml already lists this machine (#{recipients.size} recipient(s))"
      end
    else
      abort!("cannot write .sops.yaml without a public key") unless public_key
      File.write(SOPS_CONFIG, sops_config_for(public_key))
      puts "  ✓ wrote local .sops.yaml (ignored in this public source repository)"
    end

    ensure_gitignore!

    ENVIRONMENTS.each do |environment|
      path = vault_path(environment)
      if File.exist?(path)
        puts "  · config/secrets/#{environment}.enc.yaml exists (#{names(environment).size} names)"
      else
        puts "  · config/secrets/#{environment}.enc.yaml missing — seed it with:"
        puts "      bin/secrets import #{environment} --from .env"
      end
    end

    puts "\nNext: bin/secrets status"
  end

  # Written only when there is no .sops.yaml at all — i.e. on a fresh repo.
  # `age:` is a comma-separated recipient list; adding a second machine means
  # appending its public key here and running `bin/secrets rekey`.
  def sops_config_for(public_key)
    <<~YAML
      # Which age identities can decrypt which files. Public keys only — this
      # file is local operator configuration, ignored by this public repository.
      #
      # Adding a machine or a collaborator: append their public key to `age`
      # below (comma-separated), then run `bin/secrets rekey` on a machine that
      # can already decrypt. Removing one is the same edit in reverse, followed
      # by rotating every value it could read — it kept a copy of the plaintext
      # the moment it could decrypt, and git history keeps the old ciphertext.
      creation_rules:
        - path_regex: config/secrets/.*\\.enc\\.yaml$
          age: #{public_key}
    YAML
  end

  # The one guard a new project always forgets. Appends, never rewrites, and
  # does nothing if the rules are already there.
  def ensure_gitignore!
    path = File.join(ROOT, ".gitignore")
    body = File.exist?(path) ? File.read(path) : ""
    return puts "  · .gitignore already protects config/secrets/" if body.include?("config/secrets/*")

    rules = <<~RULES
      # Keep deployment vaults, including ciphertext, in private operator storage.
      /config/secrets/*
      /.sops.yaml

      # Plaintext environment files. The vault replaces these.
      /.env*
      !/.env.example
    RULES

    File.write(path, body.empty? ? rules : "#{body.rstrip}\n\n#{rules}")
    puts "  ✓ added the vault rules to .gitignore"
  end

  def cmd_list(argv)
    environment = resolve_environment(argv.shift)
    present = names(environment)
    abort!("no vault at config/secrets/#{environment}.enc.yaml") if present.empty? && !File.exist?(vault_path(environment))

    blank = blank_names(environment)
    spilled = unencrypted_names(environment)

    puts "config/secrets/#{environment}.enc.yaml — #{present.size} names (values are never printed)"
    width = present.map(&:length).max.to_i
    present.each do |name|
      note = if spilled.include?(name) then "  ✗ PLAINTEXT — do not commit"
      elsif blank.include?(name) then "  · empty"
      end
      puts format("  %-#{width}s%s", name, note)
    end

    puts "\n  #{blank.size} name(s) declared but not filled in: bin/secrets edit #{environment}" if blank.any?
    return if spilled.empty?

    warn "\n  ✗ NOT ENCRYPTED: #{spilled.join(', ')}"
    warn "    Do not commit this file. Re-encrypt with: bin/secrets rekey"
    exit 1
  end

  def cmd_status(_argv)
    puts "Encrypted secret vaults\n\n"

    puts key_available? ? "  ✓ age identity present (#{KEY_FILE})" : "  ✗ no age identity — this machine cannot decrypt"
    puts

    ENVIRONMENTS.each do |environment|
      unless File.exist?(vault_path(environment))
        puts "  config/secrets/#{environment}.enc.yaml — missing"
        next
      end

      blank = blank_names(environment)
      spilled = unencrypted_names(environment)
      filled = names(environment).size - blank.size
      puts "  config/secrets/#{environment}.enc.yaml — #{filled} filled, #{blank.size} empty"
      puts "    · empty: #{blank.join(', ')}" if blank.any?
      puts "    ✗ NOT ENCRYPTED: #{spilled.join(', ')}" if spilled.any?
    end
    puts

    contract = required_names("production")
    production = names("production")
    missing = contract - production
    unfilled = contract & blank_names("production")
    puts "  Required by this repository (deploy config, workflows, .env.example)"
    if contract.empty?
      puts "    · nothing derivable — this project declares its names by hand"
    elsif missing.empty? && unfilled.empty?
      puts "    ✓ all #{contract.size} names are in the production vault, with values"
    else
      puts "    ✗ absent from the production vault: #{missing.join(', ')}" if missing.any?
      puts "    ✗ present but empty — a deploy will abort on these: #{unfilled.join(', ')}" if unfilled.any?
    end
    puts

    remote = github_names
    if remote.nil?
      puts "  GitHub Actions secrets — not checked (gh unavailable or not authenticated)"
    else
      pushable = production - blank_names("production")
      absent = pushable - remote
      extra = remote - production
      puts "  GitHub Actions secrets (the derived copy CI reads)"
      puts absent.empty? ? "    ✓ every filled vault name exists in GitHub" : "    ✗ never pushed: #{absent.join(', ')}"
      puts "    · in GitHub but not in the vault: #{extra.join(', ')}" if extra.any?
      puts "    Values cannot be compared — GitHub never reveals one. Run `bin/secrets push` after any edit."
    end

    exit 1 if missing.any? || unfilled.any? ||
              ENVIRONMENTS.any? { |environment| unencrypted_names(environment).any? }
  end

  def cmd_edit(argv)
    environment = resolve_environment(argv.shift)
    require_key!
    path = require_vault!(environment)
    before = names(environment)

    exit 1 unless system(sops_env, sops!, "edit", path)

    added = names(environment) - before
    removed = before - names(environment)
    puts "  ✓ re-encrypted config/secrets/#{environment}.enc.yaml"
    puts "    added:   #{added.join(', ')}" if added.any?
    puts "    removed: #{removed.join(', ')}" if removed.any?
    puts "    Next: bin/secrets push" if environment == PUSHABLE
  end

  def cmd_exec(argv)
    environment = resolve_environment(argv.first && !argv.first.start_with?("-") ? argv.shift : nil)
    argv.shift if argv.first == "--"
    abort!("nothing to run — bin/secrets exec [ENV] -- CMD [ARGS...]") if argv.empty?

    # A nested bin/secrets exec would decrypt a second time for no reason, and
    # bin/dev re-execs itself through here; the guard makes that idempotent.
    if ENV["SECRETS_ENV"] == environment
      exec(*argv)
    end

    values = load_values(environment)
    # An unfilled name must stay unset rather than become "". The app reads
    # configuration through Credential/ApplicationConfig, where absent means
    # "degrade this feature" and empty means "here is a key" — a blank
    # OPENROUTER_API_KEY would be an LLM call with no credential rather than
    # the composed fallback.
    blank = values.select { |_, value| value.to_s.empty? }.keys
    values = values.reject { |name, _| blank.include?(name) }
    warn "secrets: #{environment} — unset because they are empty in the vault: #{blank.sort.join(', ')}" if blank.any?
    warn "secrets: #{environment} vault has no values" if values.empty?

    # exec with an explicit env hash: no shell, so nothing is quoted, logged to
    # a history file, or visible in `ps`.
    exec(values.merge("SECRETS_ENV" => environment), *argv)
  end

  def cmd_import(argv)
    source = nil
    parser = OptionParser.new do |o|
      o.banner = "Usage: bin/secrets import ENV --from PATH"
      o.on("--from PATH", "KEY=VALUE file to read (e.g. .env)") { |p| source = p }
    end
    environment = resolve_environment(argv.first && !argv.first.start_with?("-") ? argv.shift : nil)
    parser.parse!(argv)
    abort!("--from PATH is required") unless source
    abort!("#{source} does not exist") unless File.exist?(source)
    require_key!
    sops!

    incoming = File.readlines(source).each_with_object({}) do |line, acc|
      next if line.strip.empty? || line.strip.start_with?("#")

      name, value = line.chomp.split("=", 2)
      next unless name && value
      next unless name.match?(/\A[A-Z][A-Z0-9_]*\z/)

      acc[name] = value.gsub(/\A["']|["']\z/, "")
    end
    abort!("#{source} has no KEY=VALUE lines") if incoming.empty?

    path = vault_path(environment)
    existing = File.exist?(path) ? load_values(environment) : {}
    overlap = existing.keys & incoming.keys

    puts "secrets: importing #{incoming.size} names from #{source} into #{environment}"
    puts "  new:       #{(incoming.keys - existing.keys).join(', ')}" if (incoming.keys - existing.keys).any?
    puts "  overwrite: #{overlap.join(', ')}" if overlap.any?
    print "  Proceed? [y/N] "
    abort!("aborted.") unless $stdin.gets&.strip&.downcase&.start_with?("y")

    merged = existing.merge(incoming)
    write_vault(environment, merged)
    puts "  ✓ config/secrets/#{environment}.enc.yaml now holds #{merged.size} names"
    puts "    #{source} is untouched — delete it yourself once you have verified bin/secrets exec works."
  end

  # Encrypt a plaintext hash into the vault without ever writing it to disk:
  # sops reads the YAML on stdin and emits ciphertext on stdout.
  def write_vault(environment, values)
    require "fileutils"
    require "tempfile"
    FileUtils.mkdir_p(VAULT_DIR)
    path = vault_path(environment)

    plaintext = values.sort.to_h.to_yaml
    ciphertext, status = Open3.capture2(
      sops_env,
      sops!, "encrypt", "--filename-override", path, "--input-type", "yaml", "--output-type", "yaml", "/dev/stdin",
      stdin_data: plaintext, chdir: ROOT
    )
    abort!("sops could not encrypt the #{environment} vault") unless status.success?

    # Write via a temp file in the same directory so an interrupted write cannot
    # truncate a vault that is currently readable.
    tmp = Tempfile.create([ "#{environment}.enc", ".yaml" ], VAULT_DIR)
    tmp.write(ciphertext)
    tmp.close
    File.chmod(0o600, tmp.path)
    File.rename(tmp.path, path)
  end

  # Create or extend a vault with every name this repository demands, leaving
  # each value empty for `bin/secrets edit` to fill. Adding a secret to the
  # deploy config or a workflow is therefore the whole change: run this and
  # the vault catches up.
  def cmd_scaffold(argv)
    environment = resolve_environment(argv.shift)
    sops!
    required = required_names(environment)
    existing = File.exist?(vault_path(environment)) ? entries(environment) : {}
    added = required - existing.keys

    if added.empty?
      puts "secrets: the #{environment} vault already declares all #{required.size} required names"
    else
      require_key! if existing.any?
      # An entirely new vault needs no decryption, only the public recipients.
      merged = existing.any? ? load_values(environment) : {}
      added.each { |name| merged[name] = "" }
      write_vault(environment, merged)
      puts "secrets: added #{added.size} empty name(s) to the #{environment} vault"
      added.each { |name| puts "  · #{name}" }
      puts "\n  Fill them in with: bin/secrets edit #{environment}"
    end

    unmanaged = existing.keys - required
    puts "\n  · in the vault but not required by config: #{unmanaged.sort.join(', ')}" if unmanaged.any?
  end

  def cmd_push(argv)
    only = []
    yes = false
    parser = OptionParser.new do |o|
      o.banner = "Usage: bin/secrets push [production] [--only NAME] [--yes]"
      o.on("--only NAME", "Push just this name (repeatable)") { |n| only << n }
      o.on("--yes", "Skip the confirmation prompt") { yes = true }
    end
    environment = resolve_environment(
      argv.first && !argv.first.start_with?("-") ? argv.shift : nil, default: PUSHABLE
    )
    parser.parse!(argv)

    unless environment == PUSHABLE
      abort!("only the #{PUSHABLE} vault is pushed to GitHub — development secrets stay on this machine")
    end

    _, gh_ok = Open3.capture2e("which", "gh")
    abort!("the GitHub CLI is required — brew install gh && gh auth login") unless gh_ok.success?

    values = load_values(environment)
    missing = only - values.keys
    abort!("not in the #{environment} vault: #{missing.join(', ')}") if missing.any?

    selected = only.empty? ? values : values.slice(*only)
    # Pushing "" would set a GitHub secret that exists and is empty, which Kamal
    # resolves without complaint and ships as a blank key. Absent is the honest
    # state, and script/materialise_kamal_secrets.rb fails loudly on it.
    skipped = selected.select { |_, value| value.to_s.empty? }.keys.sort
    selected = selected.reject { |name, _| skipped.include?(name) }
    warn "  · skipping (empty in the vault, fill them with `bin/secrets edit #{environment}`): #{skipped.join(', ')}" if skipped.any?
    abort!("nothing to push") if selected.empty?

    repo, = Open3.capture2("gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner", chdir: ROOT)
    puts "secrets: pushing #{selected.size} names to GitHub Actions secrets on #{repo.strip}"
    selected.keys.sort.each { |name| puts "  #{name}" }
    puts "  This overwrites whatever GitHub holds for each name. Values are not printed."

    unless yes
      print "  Proceed? [y/N] "
      abort!("aborted.") unless $stdin.gets&.strip&.downcase&.start_with?("y")
    end

    failures = []
    selected.sort.each do |name, value|
      # Value goes in on stdin, never as an argv element: a command line is
      # visible to every process on the machine.
      _, status = Open3.capture2e("gh", "secret", "set", name, chdir: ROOT, stdin_data: value.to_s)
      status.success? ? (puts "  ✓ #{name}") : (failures << name)
    end

    if failures.any?
      abort!("failed to set: #{failures.join(', ')}")
    end

    puts "\n  ✓ GitHub is in step with the #{environment} vault."
    puts "    Kamal injects secrets at deploy time, so this takes effect on the next release:"
    puts "      bin/deploy"
  end

  def cmd_rekey(_argv)
    require_key!
    sops!
    ENVIRONMENTS.each do |environment|
      path = vault_path(environment)
      next unless File.exist?(path)

      if system(sops_env, sops!, "updatekeys", "--yes", path)
        puts "  ✓ re-encrypted config/secrets/#{environment}.enc.yaml to the recipients in .sops.yaml"
      else
        abort!("could not re-encrypt #{environment}")
      end
    end
  end

  COMMANDS = {
    "init" => :cmd_init,
    "list" => :cmd_list,
    "scaffold" => :cmd_scaffold,
    "status" => :cmd_status,
    "edit" => :cmd_edit,
    "exec" => :cmd_exec,
    "import" => :cmd_import,
    "push" => :cmd_push,
    "rekey" => :cmd_rekey
  }.freeze

  def usage
    puts File.read(__FILE__)[/^# Usage:.*?(?=\n#\n)/m].gsub(/^# ?/, "")
    puts "\nEnvironments: #{ENVIRONMENTS.join(', ')}"
  end

  def call(argv)
    command = argv.shift
    return cmd_status(argv) if command.nil?
    return usage if %w[-h --help help].include?(command)

    handler = COMMANDS[command]
    abort!("unknown command #{command.inspect} — one of: #{COMMANDS.keys.join(', ')}") unless handler
    public_send(handler, argv)
  end
end

Secrets.call(ARGV) if $PROGRAM_NAME == __FILE__
