    {
      "id": "concept-decision-quality-review-order",
      "slug": "hindsight-resistant-review-order",
      "lesson_slug": "decision-quality",
      "difficulty": "foundation",
      "prerequisite_ids": ["concept-decision-quality-outcome-boundary"],
      "display": {
        "en": {
          "title": "Hindsight-resistant review order",
          "summary": "Freeze the decision-time state before using the result as additional evidence."
        },
        "zh": {
          "title": "抗 hindsight 的复盘顺序",
          "summary": "先冻结 decision-time state，再把 result 当作额外 evidence。"
        }
      },
