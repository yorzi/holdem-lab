  "concepts": [
    {
      "id": "concept-position-preflop-action-order",
      "slug": "preflop-action-order",
      "lesson_slug": "position",
      "difficulty": "foundation",
      "prerequisite_ids": [],
      "display": {
        "en": {
          "title": "Preflop action order",
          "summary": "In heads-up play, the button/small blind acts first before the flop."
        },
        "zh": {
          "title": "Preflop 行动顺序",
          "summary": "Heads-up 中，button/small blind 在 flop 前先行动。"
        }
      },
      "source_reference_ids": ["source-ref-position-heads-up-order-v1"],
      "publication_status": "published",
      "rights_status": "original_authored",
      "domain_review": {"status": "approved", "reviewer": "Andy Wang (product owner)", "reviewed_at": "2026-08-25"}
    },
    {
      "id": "concept-position-postflop-action-order",
      "slug": "postflop-action-order",
      "lesson_slug": "position",
      "difficulty": "foundation",
      "prerequisite_ids": ["concept-position-preflop-action-order"],
      "display": {
        "en": {
          "title": "Postflop action order",
          "summary": "The big blind acts first postflop and the button acts last."
        },
        "zh": {
          "title": "Postflop 行动顺序",
          "summary": "Postflop 由 big blind 先行动，button 最后行动。"
        }
      },
      "source_reference_ids": ["source-ref-position-heads-up-order-v1"],
      "publication_status": "published",
      "rights_status": "original_authored",
      "domain_review": {"status": "approved", "reviewer": "Andy Wang (product owner)", "reviewed_at": "2026-08-25"}
    },
    {
      "id": "concept-position-information-timing",
      "slug": "information-timing",
      "lesson_slug": "position",
      "difficulty": "foundation",
      "prerequisite_ids": ["concept-position-preflop-action-order", "concept-position-postflop-action-order"],
      "display": {
        "en": {
          "title": "Information timing",
          "summary": "Acting later reveals an action before your decision without deciding the best action for you."
        },
        "zh": {
          "title": "信息时机",
          "summary": "后行动意味着先看到对手 action，但不会自动决定最佳 action。"
        }
      },
      "source_reference_ids": ["source-ref-position-information-boundary-v1"],
      "publication_status": "published",
      "rights_status": "original_authored",
      "domain_review": {"status": "approved", "reviewer": "Andy Wang (product owner)", "reviewed_at": "2026-08-25"}
    },
    {
      "id": "concept-pot-odds-call-threshold",
      "slug": "call-threshold",
      "lesson_slug": "pot-odds",
      "difficulty": "foundation",
      "prerequisite_ids": [],
      "display": {
        "en": {
          "title": "Call-price threshold",
          "summary": "Required equity equals the call divided by the pot after adding that call."
        },
        "zh": {
          "title": "Call price threshold",
          "summary": "Required equity 等于 call 除以加入该 call 后的最终 pot。"
        }
      },
      "source_reference_ids": ["source-ref-pot-odds-call-threshold-v1"],
      "publication_status": "published",
      "rights_status": "original_authored",
      "domain_review": {"status": "approved", "reviewer": "Andy Wang (product owner)", "reviewed_at": "2026-08-25"}
    },
    {
      "id": "concept-pot-odds-bet-fraction",
      "slug": "bet-fraction-conversion",
      "lesson_slug": "pot-odds",
      "difficulty": "foundation",
      "prerequisite_ids": ["concept-pot-odds-call-threshold"],
      "display": {
        "en": {
          "title": "Bet-fraction conversion",
          "summary": "A bet fraction can be converted into an immediate-call threshold under explicit assumptions."
        },
        "zh": {
          "title": "Bet fraction 转换",
          "summary": "在明确假设下，可以把 bet fraction 转换为 immediate-call threshold。"
        }
      },
      "source_reference_ids": ["source-ref-pot-odds-bet-fraction-v1"],
      "publication_status": "published",
      "rights_status": "original_authored",
      "domain_review": {"status": "approved", "reviewer": "Andy Wang (product owner)", "reviewed_at": "2026-08-25"}
    },
    {
      "id": "concept-pot-odds-price-versus-equity",
      "slug": "price-versus-equity",
      "lesson_slug": "pot-odds",
      "difficulty": "foundation",
      "prerequisite_ids": ["concept-pot-odds-call-threshold"],
      "display": {
        "en": {
          "title": "Price versus equity",
          "summary": "A threshold describes price; a call decision still needs an explicit equity model."
        },
        "zh": {
          "title": "Price 与 equity",
          "summary": "Threshold 描述 price；call decision 仍需要明确的 equity model。"
        }
      },
      "source_reference_ids": ["source-ref-pot-odds-reference-values-v1"],
