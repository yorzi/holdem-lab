    {
      "id": "concept-decision-quality-outcome-boundary",
      "slug": "outcome-boundary",
      "lesson_slug": "decision-quality",
      "difficulty": "foundation",
      "prerequisite_ids": [],
      "display": {
        "en": {
          "title": "Outcome boundary",
          "summary": "A result is evidence about an outcome, not a verdict on one decision."
        },
        "zh": {
          "title": "Outcome 边界",
          "summary": "Result 是 outcome 的 evidence，不是对单次 decision 的 verdict。"
        }
      },
      "source_reference_ids": ["source-ref-decision-outcome-boundary-v1"],
      "publication_status": "published",
      "rights_status": "original_authored",
