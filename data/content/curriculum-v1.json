    },
    {
      "id": "concept-decision-quality-confidence-calibration",
      "slug": "confidence-calibration",
      "lesson_slug": "decision-quality",
      "difficulty": "foundation",
      "prerequisite_ids": ["concept-decision-quality-outcome-boundary"],
      "display": {
        "en": {
          "title": "Confidence calibration",
          "summary": "Confidence becomes useful when compared with correctness across repeated attempts."
        },
        "zh": {
          "title": "Confidence calibration",
          "summary": "Confidence 要在多次尝试中与 correctness 对照才有意义。"
        }
      },
      "source_reference_ids": ["source-ref-decision-confidence-v1"],
      "publication_status": "published",
